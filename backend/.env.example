PORT=3000

# Origin frontend yang boleh memanggil API, dipisah koma. Kosong: semua origin diizinkan (dev).
CORS_ORIGIN=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=personalearn

JWT_SECRET=ganti-dengan-string-acak
JWT_EXPIRES_IN=7d

# Akun admin yang dibuat oleh npm run db:seed
ADMIN_EMAIL=admin@personalearn.id
ADMIN_PASSWORD=admin123

# Folder foto profil (relatif terhadap folder backend)
UPLOAD_DIR=uploads

# Pengiriman OTP lupa kata sandi. Kosong: kode dicetak ke console backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Sinau Bot (Google Gemini generateContent). Isi AI_API_KEY dengan kunci dari Google AI Studio.
# AI_API_KEY kosong: bot membalas pesan cadangan. CHAT_DAILY_LIMIT: batas pesan per pengguna per hari.
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
CHAT_DAILY_LIMIT=100

# Pengingat belajar otomatis (dicek tiap menit). REMINDER_ENABLED=false untuk mematikan.
REMINDER_ENABLED=true
REMINDER_TZ=Asia/Jakarta
